{
  "$schema": "https://json.schemastore.org/package.json",
  "name": "dsh-plugin-workbuddy-checkin",
  "version": "1.0.1",
  "description": "WorkBuddy daily auto check-in and credit claiming for DeepSeek Harness: check-in, growth tasks, buddy travel, streak redemption and lottery in one run. No tokens required — uses an isolated Chrome login profile.",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "license": "MIT",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "workbuddy",
    "checkin",
    "credits",
    "automation",
    "chrome",
    "签到",
    "积分"
  ],
  "files": [
    "lib/index.js",
    "lib/engine/web_checkin.mjs",
    "lib/types/**/*.d.ts",
    "cordis.patch.yml",
    "README.md",
    "INSTALL.md",
    "LICENSE",
    "PUBLISHING.md",
    "SHARING.md",
    "NOTICE.md"
  ],
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "dependencies": {
    "puppeteer-core": "^25.5.0"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.5",
    "@deepseek-ai/dsh-tools": "^0.2.1-rc.1",
    "@deepseek-ai/schemastery": "^3.18.1"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  }
}
